# QE Agent configuration. Every value here has a working default — a fresh
# install needs none of this. Copy to .env only to change something.

# --- storage --------------------------------------------------------------
# GALEQEA_HOME=~/.galeqea
# GALEQEA_DATABASE_URL=sqlite:///~/.galeqea/galeqea.db
# GALEQEA_DATABASE_URL=postgresql+psycopg://galeqea:galeqea@localhost:5432/galeqea

# --- server ---------------------------------------------------------------
# GALEQEA_HOST=127.0.0.1
# GALEQEA_PORT=8080
# Single-user desktop mode skips the login screen. Set to false for any
# deployment reachable by more than one person.
# GALEQEA_SINGLE_USER_MODE=true

# --- model ----------------------------------------------------------------
# Modes: no_ai (default) | api_key | local | byo_agent
# GALEQEA_AI_MODE=no_ai
# GALEQEA_PROVIDER=anthropic          # anthropic|openai|gemini|azure_openai|ollama|openai_compatible|claude_cli
# GALEQEA_MODEL=claude-opus-5
# GALEQEA_API_KEY=
# GALEQEA_BASE_URL=                   # e.g. http://localhost:11434/v1 for Ollama
# GALEQEA_MAX_TOKENS_PER_RUN=200000
# GALEQEA_MAX_AGENT_STEPS=40
# Opt-in only. When false the agent has no web access at all.
# GALEQEA_WEB_RESEARCH_ENABLED=false

# --- governance -----------------------------------------------------------
# per_action | gated_batch | auto_low_risk
# GALEQEA_APPROVAL_MODE=per_action

# --- execution ------------------------------------------------------------
# GALEQEA_MAX_PARALLEL_RUNS=4
# GALEQEA_DEFAULT_BROWSER=chromium
# GALEQEA_DEFAULT_TIMEOUT_MS=30000

# --- telemetry ------------------------------------------------------------
# Off by default and off by design. QE Agent sends nothing anywhere.
# GALEQEA_TELEMETRY_ENABLED=false
