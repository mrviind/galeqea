{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source scraping GaleQEA /metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "GaleQEA",
  "uid": "galeqea",
  "tags": ["galeqea", "qe"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Runs executing now (queue depth)",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "galeqea_active_runs", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Self-heals applied (1h)",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "increase(galeqea_heals_total[1h])", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "LLM tokens (cumulative)",
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum(galeqea_llm_tokens_total)", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Runs finished per 5m, by status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (status) (increase(galeqea_runs_total[5m]))", "legendFormat": "{{status}}", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Test failure rate per 5m",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum(increase(galeqea_failures_total[5m]))", "legendFormat": "failures", "refId": "A" },
        { "expr": "sum(increase(galeqea_tests_total[5m]))", "legendFormat": "executions", "refId": "B" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "LLM token rate (per 5m)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (kind) (increase(galeqea_llm_tokens_total[5m]))", "legendFormat": "{{kind}}", "refId": "A" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Approval decisions per 1h, by outcome",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (decision) (increase(galeqea_approvals_total[1h]))", "legendFormat": "{{decision}}", "refId": "A" }
      ]
    }
  ]
}
