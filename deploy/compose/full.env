# Full profile: Postgres 16 (pgvector) + SeaweedFS (S3) + worker + Valkey.
#
#   docker compose --env-file deploy/compose/full.env up
#
# COMPOSE_PROFILES=full starts the extra services; the rest wire the single
# `galeqea` app to them. For a real deployment, point these at your managed
# Postgres and S3 instead (see docs/DEPLOY.md) and change every secret below.

COMPOSE_PROFILES=full

# --- database: the pgvector Postgres service in this compose file ---
GALEQEA_DATABASE_URL=postgresql+psycopg://galeqea:galeqea@postgres:5432/galeqea

# --- object storage: the SeaweedFS S3 gateway in this compose file ---
GALEQEA_STORAGE_BACKEND=s3
GALEQEA_S3_ENDPOINT=http://seaweedfs:8333
GALEQEA_S3_BUCKET=galeqea-artifacts
GALEQEA_S3_REGION=us-east-1
GALEQEA_S3_ACCESS_KEY_ID=galeqea
GALEQEA_S3_SECRET_ACCESS_KEY=galeqea-secret
# SeaweedFS and most self-hosted S3 need path-style addressing.
GALEQEA_S3_FORCE_PATH_STYLE=true

# --- optional cache/queue backend ---
GALEQEA_REDIS_URL=redis://valkey:6379/0

# --- first-run admin (multi-user). Leave the password blank to get a one-time
#     setup link in the logs instead. Change these before any real use. ---
GALEQEA_ADMIN_EMAIL=admin@example.com
# GALEQEA_ADMIN_PASSWORD=change-me-now
