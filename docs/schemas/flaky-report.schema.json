{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galeqea.dev/schemas/flaky-report.schema.json",
  "title": "GaleQEA flaky report",
  "type": "object",
  "required": [
    "schema_version",
    "report",
    "project_id",
    "href",
    "summary",
    "tests"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "report": {
      "const": "flaky"
    },
    "project_id": {
      "type": "string"
    },
    "href": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "required": [
        "flaky_count",
        "evaluated"
      ]
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "href",
          "ui_href",
          "key",
          "score",
          "confidence",
          "reasons"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "href": {
            "type": "string"
          },
          "ui_href": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  }
}
